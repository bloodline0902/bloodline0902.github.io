# Canonical site origin — no trailing slash.
# Used for metadataBase, Open Graph / Twitter URLs, canonical links, sitemap.xml,
# robots.txt, and article JSON-LD.
#
# --- Local ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# --- GitHub Pages (production) ---
# User/org site (username.github.io repo):
# NEXT_PUBLIC_SITE_URL=https://bloodline0902.github.io
#
# Project site (repo name ≠ username.github.io), pages under /repo/:
# NEXT_PUBLIC_SITE_URL=https://bloodline0902.github.io/bloodline0902
# NEXT_PUBLIC_BASE_PATH=/bloodline0902

# Google Search Console site-ownership token — the `content` value of the
# HTML-tag verification method, not the whole tag.
#
# Not a secret: it is served in the HTML of every page, which is its purpose.
# Supplied in CI as a GitHub Actions repository *variable*, not a secret.
# Leave unset locally — the meta tag is then omitted entirely, so local and
# fork builds never claim ownership of the verified property.
#
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
